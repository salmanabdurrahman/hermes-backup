# Hermes Agent Backup Configuration Template
# Copy this file to .env and configure with your credentials

# Hermes Directory
HERMES_HOME=/home/salmanabd/.hermes

# Cloudflare R2 Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=hermes-backups
# Optional: Leave blank to auto-derive from R2_ACCOUNT_ID
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Brevo (Sendinblue) Transactional Email Credentials
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME="Hermes Backup Bot"
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_RECIPIENT_EMAIL=admin@yourdomain.com

# Retention & Storage Settings (Max 3 days retention by default)
BACKUP_RETENTION_DAYS=3
BACKUP_TEMP_DIR=/tmp

# Optional Client-Side Archive Encryption (AES-256-GCM)
# Leave unset or empty to store unencrypted archives
# BACKUP_ENCRYPTION_KEY=your_strong_symmetric_passphrase_here
